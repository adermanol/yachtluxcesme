# Netlify ortam değişkenleri (Site settings → Environment variables).
# service_role key KULLANILMAZ — sadece anon key yeterli, RLS yetkilendirmeyi yapar.

SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...

