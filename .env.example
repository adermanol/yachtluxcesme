# Netlify ortam değişkenleri (Site settings → Environment variables).
# Üçüncü parti servis yok.

# Admin panel şifresi (tek kullanıcı, Bölüm 3/12).
ADMIN_PASSWORD=

# Oturum token'larını imzalamak için rastgele, uzun bir string.
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Netlify Blobs manuel bağlantı (otomatik algılama bazı sitelerde başarısız
# oluyor — bu ikisi tanımlıysa netlify/functions/_store.js otomatik yerine
# bunu kullanır):
#   SITE_ID     → Netlify dashboard → Site configuration → General →
#                 Site details → "Site ID"
#   BLOBS_TOKEN → Netlify dashboard → sağ üst hesap ikonu → User settings →
#                 Applications → "New access token" (Personal Access Token)
SITE_ID=
BLOBS_TOKEN=
